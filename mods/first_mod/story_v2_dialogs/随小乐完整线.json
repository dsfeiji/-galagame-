          "staminaCost": 1
        }
      ]
    },
    {
      "id": "detail",
      "text": "随小乐：衣角很干净，不像刚跑过操场的人。那个人停了一下，像是在听广播室那边的声音。",
      "nextNodeId": "",
      "conditionJumps": [],
      "rewards": [],
      "choices": [
        {
          "text": "请她写下证词。",
